    "lightweight-charts": "^5.0.0",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "cheerio": "1.0.0",
    "hardhat": "^2.26.3",
    "solc": "0.8.30",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "ws": "^8.18.3"
  }
