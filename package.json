    "contracts:deploy": "tsx scripts/deploy.ts",
    "fund": "tsx scripts/fund.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
