{
  "name": "arc-chart-trading-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "tsx scripts/serve.ts dev",
    "build": "next build",
    "start": "tsx scripts/serve.ts start",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:contracts": "tsx tests/contracts.ts",
    "test:e2e": "playwright test",
    "seo:check": "tsx scripts/check-seo.ts",
